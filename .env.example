# Copie para .env (o .env nunca vai para o Git). Na Hostinger, cadastre as mesmas
# variáveis no painel do app Node.js.

# URL pública do site (canonical, Open Graph, sitemap e RSS). Usada no build.
VITE_SITE_URL=https://vibecoin.com.br

# MySQL. Sem DB_NAME/DB_USER o site usa os dados de exemplo (mock-data.ts).
# Na Hostinger: host 127.0.0.1 (nunca o srvNNNN.hstgr.io).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Próximas fases (robô, cotações e admin):
# CRON_TOKEN=
# GEMINI_API_KEY=
# COINGECKO_API_KEY=   (chave "Demo" gratuita da CoinGecko: cotações, gráficos, histórico)
# ADSENSE_CLIENT=      (opcional: ca-pub-… do AdSense; liga anúncios, ads.txt e banner de cookies)
# ADMIN_EMAIL=
# ADMIN_PASSWORD_HASH=
# SESSION_SECRET=
# Pasta das imagens das matérias (padrão: ~/vibecoin-media)
# MEDIA_DIR=
